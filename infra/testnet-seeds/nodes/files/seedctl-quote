#
# seedctl-quote: the pool-quotes half of seedctl (sourced by seedctl, never run by itself). A network
# whose `pool` has a `quote` runs the Yellowback quote agent beside its node (README.md, "The pool":
# "Pool quotes"): yellowback-quote (ycash6 contrib/yellowback, images/quote) fetches the YEC price
# from the public sources its image carries and calls yed_setquote on the node
# every poll_seconds (one block by default). The node puts the quote into its coinbase tag,
# which names the pool's payout address (-yellowbackpayoutaddress, locals.tf: an address, no key on
# the host). Outbound HTTPS only; nothing listens. Where Yellowback is not active yet (no attestor
# set on the network) the node has no yed_* calls: the agent logs that once and keeps asking, so the
# agent can be deployed before the release that turns Yellowback on. Installed beside seedctl by the
# deploy workflow (the module's host_files, `seedctl install-files`), kept on the data volume for `boot`.
# shellcheck disable=SC2034  # variables used by seedctl, which sources this file
# shellcheck disable=SC2154  # D, O, cfg, die, cli, dinspect, imds_guard: seedctl's

UID_QUOTE=2005               # the quote image's user (images/quote/Dockerfile: useradd --uid 2005)

quote_check() { # file name
  jq -e '
    (.pool.quote.image | test("^[a-z0-9][a-z0-9._/:-]*@sha256:[0-9a-f]{64}$"))
    and (.pool.payout | test("^sm[1-9A-HJ-NP-Za-km-z]{33}$"))
    and (.pool.quote.poll_seconds | type == "number" and . >= 30 and . <= 600 and . == floor)
  ' "$1" >/dev/null || die "config for $2: the pool's quote is not valid"
}

# NET/quote.toml: [node] (127.0.0.1, the node's own credential: readable by the agent's uid only,
# never on a command line) and [quote]; the image adds its [[sources]] (images/quote/Dockerfile).
render_quote() { # net file
  local net=$1 f=$2 R="$O/net/$1" qc="$D/$1/quote.toml"
  imds_guard "$UID_QUOTE"
  ( umask 077
    # shellcheck source=/dev/null
    . "$D/$net/rpc.env"
    printf '[node]\nrpc_url = "http://127.0.0.1:%s"\nrpc_user = "%s"\nrpc_password = "%s"\n\n[quote]\npoll_seconds = %s\n\n' \
      "$(cfg "$f" .rpc_port)" "$YCASHD_RPC_USER" "$YCASHD_RPC_PASSWORD" \
      "$(cfg "$f" .pool.quote.poll_seconds)" > "$qc.new" )
  if [ "$(id -u)" = 0 ]; then chown "$UID_QUOTE:$UID_QUOTE" "$qc.new"; fi
  chmod 0400 "$qc.new"; mv -f "$qc.new" "$qc"
  cat >> "$R/compose.yaml" <<YAML
  quote:
    image: $(cfg "$f" .pool.quote.image)
    container_name: quote-$net
    restart: unless-stopped
    network_mode: host
    depends_on: [ycashd]
    user: "$UID_QUOTE:$UID_QUOTE"
    read_only: true
    tmpfs: ["/tmp:size=1m,mode=0700,uid=$UID_QUOTE,gid=$UID_QUOTE"]
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    mem_limit: 128m
    volumes: ["$qc:/etc/yellowback-quote/host.toml:ro"]
    stop_grace_period: 10s
    logging: { driver: json-file, options: { max-size: 20m, max-file: "4" } }
YAML
}

# pool.quote in status: the container, and the node's own view (yed_getinfo miner): quoteKind
# "quote" while a fresh quote is held; null while Yellowback is not active (no yed_* calls).
quote_status() { # net pool-json
  local m
  m=$(cli "$1" yed_getinfo 2>/dev/null | jq -c '.miner // {}' 2>/dev/null) || m='{}'
  [ -n "$m" ] || m='{}'
  jq -c --arg st "$(dinspect '{{.State.Status}}' "quote-$1" absent)" --arg img "$(dinspect '{{.Config.Image}}' "quote-$1" -)" --argjson m "$m" \
    '. + {quote: {container: $st, image: $img, quoteKind: ($m.quoteKind // null), quoteAgeSeconds: ($m.quoteAgeSeconds // null), payoutAddress: ($m.payoutAddress // null)}}' <<<"$2"
}

# The explorer stack's settings (compose.yaml). `make explorer-up` copies this file to .env on first
# use and adds fresh passwords (env-init.sh); edit .env, not this file. Every value below is the
# default compose.yaml uses when the line is absent.
#
# Memory: the *_MEM_LIMIT defaults (node 1536m, PostgreSQL 768m, Inzyght 768m, proxy 128m; about
# 3.2 GiB together) fit a 4 GiB host with room for the OS and the page cache. On a bigger host raise
# the node and PostgreSQL first (and YCASHD_DBCACHE, PG_SHARED_BUFFERS with them).

# Compose project name (containers, volumes and networks are prefixed with it)
EXPLORER_PROJECT=ycash-explorer

# --- proxy ---
# ":80" = plain HTTP. A domain name (fastnet-explorer.ycash.team) = automatic HTTPS from Let's Encrypt;
# then also PROXY_BIND=0.0.0.0, PROXY_HTTP_PORT=80, PROXY_HTTPS_PORT=443.
EXPLORER_SITE=:80
PROXY_BIND=127.0.0.1
PROXY_HTTP_PORT=8090
PROXY_HTTPS_PORT=8453
PROXY_MEM_LIMIT=128m

# --- node (ycashd 6.22.0-beta2, the yb-fast seeds' digest) ---
YCASHD_NETWORK=testnet
YCASHD_TESTNET_PROFILE=fast
YCASHD_RPC_PORT=18832
# "prefix": restore the network's pinned block prefix into an empty datadir first; empty: peers only
YCASHD_BOOTSTRAP=prefix
YCASHD_ADDNODE=fastnet-seed.ycash.team:18833
# the UTXO cache in MB; keep it well under NODE_MEM_LIMIT (the import and the indexes need the rest)
YCASHD_DBCACHE=512
NODE_MEM_LIMIT=1536m
# ZMQ (hashblock, hashtx), bound to the node's backend address; its RPC answers only 127.0.0.1 and
# the backend subnet and is not published (docker compose exec node ycash-cli ...)
ZMQ_PORT=28332
# a host directory instead of the named volume, e.g. /srv/ycash-data/explorer/node (never inside a git tree)
# NODE_DATA=node-data

# --- PostgreSQL ---
PG_DATABASE=inzyght
PG_USER=inzyght
PG_SHARED_BUFFERS=256MB
PG_MEM_LIMIT=768m
# PG_DATA=pg-data

# --- Inzyght ---
INZYGHT_IMAGE=ycash/inzyght:local
INZYGHT_THREADS=4
INZYGHT_LOG_LEVEL=INFO
INZYGHT_MEM_LIMIT=768m
# the internal network's /24: the proxy is .10 (the one address Inzyght trusts for X-Forwarded-For)
# and the node .11; every other container gets an address from .128/25. Change it if it collides
# with a local network
BACKEND_PREFIX=172.31.250

# --- value pools (only with `make explorer-up EXPLORER_POOLS=1`: compose.pools.yaml, README.md "Value pools") ---
POOLS_IMAGE=ycash/value-pools:local
# shown in the page's title, e.g. "Ycash fast testnet"
POOLS_NETWORK_NAME=
POOLS_MEM_LIMIT=128m
# history: every block of the last POOLS_RECENT_BLOCKS, every POOLS_FINE_STEP-th from POOLS_FINE_FROM
# ("auto": the Ycash or Vault activation), every POOLS_COARSE_STEP-th of the whole chain
POOLS_RECENT_BLOCKS=2000
POOLS_FINE_STEP=10
POOLS_FINE_FROM=auto
POOLS_COARSE_STEP=1000
# milliseconds between the sampler's calls to the node (50 = at most 20 a second)
POOLS_RPC_INTERVAL_MS=50
